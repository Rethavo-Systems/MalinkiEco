PORT=8080
PUBLIC_BASE_URL=https://your-domain.example
PAYMENT_PROVIDER_SHOP_ID=your_provider_shop_id
PAYMENT_PROVIDER_SECRET_KEY=your_provider_secret_key
PAYMENT_PROVIDER_PAYMENTS_URL=https://your-provider.example/payments
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# eWeLink gate control. Keep real values only in deployment secrets, never in git.
EWELINK_APP_ID=your_ewelink_app_id
EWELINK_APP_SECRET=your_ewelink_app_secret
EWELINK_DEVICE_ID=your_ewelink_device_id
EWELINK_REGION=eu
EWELINK_ACCESS_TOKEN=your_initial_access_token
EWELINK_REFRESH_TOKEN=your_initial_refresh_token
EWELINK_AT_EXPIRED_TIME=0
EWELINK_RT_EXPIRED_TIME=0
EWELINK_GATE_OPEN_COOLDOWN_MS=10000
EWELINK_GATE_GLOBAL_COOLDOWN_MS=10000
